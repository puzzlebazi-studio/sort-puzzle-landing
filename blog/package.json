{
  "name": "puzzlebazi-blog",
  "private": true,
  "version": "1.0.0",
  "description": "The blog of PuzzleBazi Studio, at blog.puzzlebazi.studio: Next.js, built and shipped as its own Docker image.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build && cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start": "PORT=3200 node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "docker:build": "docker build -t puzzlebazi-blog .",
    "docker:run": "docker run --rm -p 3200:3000 puzzlebazi-blog",
    "deploy:liara": "liara deploy"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "gray-matter": "^4.0.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
